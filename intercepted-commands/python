#!/bin/bash

program=${PINNACLE_PYTHON_SHIM_NAME:-python}
unset PINNACLE_PYTHON_SHIM_NAME

block_pip() {
    echo "Error: '$program -m pip' is disabled. Use uv instead:" >&2
    echo "" >&2
    echo "  To install a package for a script: uv run --with PACKAGE python script.py" >&2
    echo "  To add a dependency to the project: uv add PACKAGE" >&2
    echo "" >&2
    exit 1
}

block_venv() {
    echo "Error: '$program -m venv' is disabled. Use uv instead:" >&2
    echo "" >&2
    echo "  To create a virtual environment: uv venv" >&2
    echo "" >&2
    exit 1
}

prev=""
for arg in "$@"; do
    case "$arg" in
        -mpip|-m\ pip) block_pip ;;
        -mvenv|-m\ venv) block_venv ;;
    esac

    if [ "$prev" = "-m" ]; then
        case "$arg" in
            pip) block_pip ;;
            venv) block_venv ;;
        esac
    fi
    prev="$arg"
done

exec uv run python "$@"
