{
  "name": "pinnacle",
  "version": "0.1.0",
  "description": "Personal Pi package with workflow commands, safety guards, skills, and prompts.",
  "keywords": [
    "coding-agent",
    "pi",
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "!extensions/**/*.test.ts",
    "!extensions/**/tests",
    "intercepted-commands",
    "skills",
    "prompts",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "check": "oxfmt --check . && bun run lint && bun run typecheck",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@oxlint/plugins": "1.90.0",
    "@types/node": "latest",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.4",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
